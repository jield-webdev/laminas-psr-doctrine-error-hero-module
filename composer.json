{
  "name": "jield-webdev/laminas-psr-doctrine-error-hero-module",
  "type": "library",
  "description": "A Hero for your Laminas and Mezzio application to trap php errors & exceptions",
  "keywords": [
    "laminas",
    "error",
    "mezzio",
    "hero",
    "log",
    "logger",
    "logging",
    "mail",
    "db",
    "doctrine",
    "handler",
    "psr3",
    "psr7",
    "psr11",
    "psr15",
    "laminas-view",
    "twig",
    "plates",
    "symfony",
    "aura",
    "pimple"
  ],
  "homepage": "https://github.com/samsonasik/ErrorHeroModule",
  "license": "MIT",
  "authors": [
    {
      "name": "Abdul Malik Ikhsan",
      "email": "samsonasik@gmail.com",
      "homepage": "https://samsonasik.wordpress.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3 || ^8.4",
    "laminas/laminas-diactoros": "^3.5.0",
    "jield-webdev/laminas-log": "dev-develop",
    "plesk/laminas-mail": "^2.26",
    "laminas/laminas-uri": "^2.12",
    "samsonasik/array-lookup": "^1.0",
    "doctrine/doctrine-orm-module": "^6.1.0 || ^7.0",
    "seld/jsonlint": "^1.9",
    "webmozart/assert": "^1.11"
  },
  "conflict": {
    "doctrine/dbal": "<3.0",
    "doctrine/doctrine-orm-module": "<4.1",
    "laminas/laminas-mvc": "<3.2|>=4.0",
    "laminas/laminas-servicemanager": "<3.10",
    "laminas/laminas-mvc-console": "*"
  },
  "require-dev": {
    "aura/di": "^3.4 || ^4.2.1",
    "doctrine/dbal": "^3.5.1",
    "laminas/laminas-cli": "^1.7",
    "laminas/laminas-coding-standard": "^2.4",
    "laminas/laminas-form": "^2.16 || ^3.8",
    "laminas/laminas-mvc": "^3.6",
    "laminas/laminas-servicemanager": "^3.20",
    "phpstan/phpstan": "^2.1.11",
    "phpstan/phpstan-webmozart-assert": "^2.0.0",
    "pimple/pimple": "^3.5",
    "rector/rector": "dev-main",
    "symfony/dependency-injection": "^5.4.16"
  },
  "config": {
    "bin-dir": "bin",
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "composer/package-versions-deprecated": true,
      "ocramius/package-versions": true
    }
  },
  "extra": {
    "laminas": {
      "module": "ErrorHeroModule"
    }
  },
  "autoload": {
    "psr-4": {
      "ErrorHeroModule\\": "src/"
    },
    "files": [
      "src/HeroFunction.php"
    ]
  },
  "autoload-dev": {
    "files": [
      "vendor/doctrine/dbal/src/Driver/PDO/MySQL/Driver.php"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "cs-check": "phpcs",
    "cs-fix": "phpcbf",
    "phpstan": "phpstan analyse src/ -c phpstan.neon --memory-limit=2G"
  }
}
